<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login - Lilo Account Provisioning</title>
    <style>
        :root {
            --lilo-purple-dark: #513761;
            --lilo-purple-header: #6B3091;
            --lilo-cyan: #36B8D8;
            --lilo-cyan-hover: #2DA1BE;
            --lilo-bg: #F4F2F7;
            --lilo-card-bg: #FFFFFF;
            --lilo-text: #2B2135;
            --lilo-border: #E2DCED;
        }
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: var(--lilo-bg); display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
        .login-card { background: var(--lilo-card-bg); border-radius: 10px; border: 1px solid var(--lilo-border); box-shadow: 0 4px 12px rgba(81, 55, 97, 0.15); width: 100%; max-width: 380px; overflow: hidden; }
        .login-header { background: var(--lilo-purple-dark); color: #FFF; padding: 20px; text-align: center; }
        .login-header h1 { margin: 0; font-size: 18px; letter-spacing: 0.5px; }
        .login-body { padding: 24px; }
        .form-group { margin-bottom: 16px; }
        .form-group label { display: block; font-size: 12px; font-weight: 700; color: var(--lilo-purple-dark); text-transform: uppercase; margin-bottom: 6px; }
        .form-group input { width: 100%; padding: 10px; border: 1px solid var(--lilo-border); border-radius: 6px; box-sizing: border-box; font-size: 14px; }
        .btn-login { width: 100%; background: var(--lilo-cyan); color: #FFF; border: none; padding: 12px; border-radius: 6px; font-weight: 700; text-transform: uppercase; cursor: pointer; letter-spacing: 0.5px; }
        .btn-login:hover { background: var(--lilo-cyan-hover); }
        .alert-error { background: #f8d7da; color: #842029; padding: 10px; border-radius: 6px; font-size: 13px; margin-bottom: 16px; text-align: center; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-header">
            <h1>Log In</h1>
        </div>
        <div class="login-body">
            <% if (error) { %>
                <div class="alert-error"><%= error %></div>
            <% } %>
            <form action="/admin/login" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <% if (returnTo) { %>
                    <input type="hidden" name="returnTo" value="<%= returnTo %>">
                <% } %>
                <div class="form-group">
                    <label>Username</label>
                    <input type="text" name="username" required autofocus autocomplete="off">
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" name="password" required>
                </div>
                <button type="submit" class="btn-login">Sign In</button>
            </form>
        </div>
    </div>
</body>
</html>