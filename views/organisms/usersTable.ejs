<div class="table-responsive">
    <table id="users-table" data-table-kind="users" data-endpoint="/admin/api/users" data-page-size="8" data-csrf="<%= csrfToken %>" <%= (typeof lazy !== 'undefined' && lazy) ? 'data-lazy' : '' %>>
        <thead>
            <tr>
                <th>User ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Payment Intent ID</th>
                <th>Created At</th>
            </tr>
        </thead>
        <tbody data-load-table>
            <%- include('../atoms/skeletonRow', { cols: 5, rows: 3 }) %>
        </tbody>
    </table>
</div>
<div class="load-more-wrap">
    <button type="button" class="btn btn-load-more" data-load-more hidden>Load More</button>
</div>