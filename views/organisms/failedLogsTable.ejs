<div class="table-responsive">
    <table id="failed-logs-table" data-table-kind="failed-logs" data-endpoint="/admin/api/failed-logs" data-page-size="8" data-csrf="<%= csrfToken %>">
        <thead>
            <tr>
                <th>Payment Intent ID</th>
                <th>Error Message</th>
                <th>Status</th>
                <th>Attempts</th>
                <th>Logged At</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody data-load-table>
            <%- include('../atoms/skeletonRow', { cols: 6, rows: 3 }) %>
        </tbody>
    </table>
</div>
<div class="load-more-wrap">
    <button type="button" class="btn btn-load-more" data-load-more hidden>Load More</button>
</div>