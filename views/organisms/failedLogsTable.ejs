<% if (!failedLogs || failedLogs.length === 0) { %>
    <p style="color: #666;">No failed provisioning events recorded.</p>
<% } else { %>
    <div class="table-responsive">
                <table>
        <thead>
            <tr>
                <th>Payment Intent ID</th>
                <th>Error Message</th>
                <th>Status</th>
                <th>Attempts</th>
                <th>Logged At</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% failedLogs.forEach(log => { %>
                <tr>
                    <td><code><%= log.payment_intent_id %></code></td>
                    <td style="color: #d81b60;"><%= log.error_message %></td>
                    <td>
                        <%- include('../atoms/badge', { status: log.status }) %>
                        <!-- keep in mind: badge lives at views/atoms/badge -->
                    </td>
                    <td><%= log.attempts %></td>
                    <td class="nowrap"><%= new Date(log.created_at).toLocaleString() %></td>
                    <td>
                        <% if (log.status === 'FAILED') { %>
                            <div class="action-group">
                                <form action="/admin/re-provision/<%= log.id %>" method="POST" style="margin:0;">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-retry" title="Re-attempt provisioning from the stored payload">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/></svg>
                                        Retry
                                    </button>
                                </form>
                                <form action="/admin/mark-refunded/<%= log.id %>" method="POST" style="margin:0;">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-refund" title="Mark this failed transaction as refunded">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v6h6"/><path d="M21 17a9 9 0 0 0-15-6.7L3 13"/></svg>
                                        Mark Refunded
                                    </button>
                                </form>
                            </div>
                        <% } else if (log.status === 'REFUNDED') { %>
                            <span style="color: #6c757d; font-size: 12px;">Refunded</span>
                        <% } else { %>
                            <span style="color: #198754; font-size: 12px;">Resolved</span>
                        <% } %>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
    </div>
<% } %>
